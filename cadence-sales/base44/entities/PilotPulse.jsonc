{
  "name": "PilotPulse",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation; resolved server-side."
    },
    "submitted_by_user_id": {
      "type": "string"
    },
    "period_key": {
      "type": "string",
      "description": "e.g. 2026-W34 \u2014 prevents duplicate submissions per period."
    },
    "calling_ease_score": {
      "type": "number",
      "description": "1-5: how easy was calling work this week."
    },
    "followup_help_score": {
      "type": "number",
      "description": "1-5: did Cadence help remember follow-ups."
    },
    "biggest_frustration": {
      "type": "string",
      "description": "Optional comment."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organisation_id",
    "submitted_by_user_id",
    "period_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}