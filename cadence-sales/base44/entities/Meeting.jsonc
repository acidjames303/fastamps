{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation; resolved server-side."
    },
    "campaign_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string",
      "description": "Opportunity this meeting belongs to."
    },
    "company_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string",
      "description": "Primary contact attending from the prospect side."
    },
    "organiser_user_id": {
      "type": "string",
      "description": "User who organised the meeting."
    },
    "assigned_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Internal attendees assigned to this meeting."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "discovery_call",
        "demo",
        "consultation",
        "site_visit",
        "proposal_discussion",
        "other"
      ],
      "default": "discovery_call"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "booked",
        "completed",
        "cancelled",
        "no_show",
        "rescheduled"
      ],
      "default": "proposed"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC start time."
    },
    "ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC end time."
    },
    "timezone": {
      "type": "string",
      "default": "Europe/London",
      "description": "Organisation timezone for display."
    },
    "location_type": {
      "type": "string",
      "enum": [
        "physical",
        "online",
        "phone",
        "hybrid"
      ],
      "default": "online"
    },
    "location": {
      "type": "string"
    },
    "meeting_url": {
      "type": "string"
    },
    "attendee_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attendee_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "client_attendee_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "client_attendee_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_call_log_id": {
      "type": "string"
    },
    "source_task_id": {
      "type": "string"
    },
    "preparation_notes": {
      "type": "string",
      "description": "Caller's preparation notes \u2014 internal only."
    },
    "client_visible_notes": {
      "type": "string",
      "description": "Safe for client reports and calendar descriptions."
    },
    "external_calendar_provider": {
      "type": "string",
      "description": "e.g. google, outlook \u2014 set when event added externally."
    },
    "external_calendar_event_id": {
      "type": "string"
    },
    "external_calendar_event_url": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancellation_reason": {
      "type": "string"
    }
  },
  "required": [
    "organisation_id",
    "opportunity_id",
    "company_id",
    "title",
    "starts_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.organisation_id": "{{user.data.organisation_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}