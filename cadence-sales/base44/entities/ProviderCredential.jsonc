{
  "name": "ProviderCredential",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation; resolved server-side, never from the client."
    },
    "provider": {
      "type": "string",
      "enum": [
        "twilio",
        "lusha",
        "fullenrich",
        "apollo",
        "rocketreach",
        "yay"
      ],
      "description": "Which provider these credentials belong to."
    },
    "encrypted_data": {
      "type": "string",
      "description": "AES-GCM encrypted JSON of credential key-value pairs. Never returned to the frontend."
    },
    "masked_identifiers": {
      "type": "object",
      "description": "Non-secret masked identifiers for display (e.g. last 4 characters of a SID)."
    },
    "field_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which credential fields are stored in this record."
    },
    "created_by_user_id": {
      "type": "string",
      "description": "User who created or last updated these credentials."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organisation_id",
    "provider",
    "encrypted_data"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}