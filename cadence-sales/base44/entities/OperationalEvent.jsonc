{
  "name": "OperationalEvent",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation where applicable."
    },
    "user_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "default": "info"
    },
    "category": {
      "type": "string",
      "enum": [
        "auth",
        "billing",
        "calling",
        "enrichment",
        "research",
        "ai",
        "integration",
        "webhook",
        "data",
        "platform"
      ]
    },
    "source_function": {
      "type": "string",
      "description": "Backend function or module that raised the event."
    },
    "error_code": {
      "type": "string"
    },
    "safe_message": {
      "type": "string",
      "description": "Safe, user-facing message. Never secrets or full provider responses."
    },
    "correlation_id": {
      "type": "string",
      "description": "For tracing related events across functions."
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_user_id": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "occurrence_count": {
      "type": "number",
      "default": 1,
      "description": "Aggregated count of identical errors."
    },
    "fingerprint": {
      "type": "string",
      "description": "Hash for deduplication of identical errors."
    }
  },
  "required": [
    "severity",
    "category",
    "safe_message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}