{
  "name": "ComplianceSettings",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation; resolved server-side."
    },
    "operating_countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "United Kingdom"
      ]
    },
    "default_lawful_basis": {
      "type": "string",
      "enum": [
        "legitimate_interest",
        "consent",
        "contract",
        "legal_obligation",
        "public_interest",
        "vital_interest"
      ],
      "default": "legitimate_interest"
    },
    "business_calling_only": {
      "type": "boolean",
      "default": true
    },
    "require_source_information": {
      "type": "boolean",
      "default": true
    },
    "require_lawful_basis": {
      "type": "boolean",
      "default": true
    },
    "require_caller_identification": {
      "type": "boolean",
      "default": true
    },
    "require_client_identification": {
      "type": "boolean",
      "default": true
    },
    "recording_enabled": {
      "type": "boolean",
      "default": false
    },
    "recording_default": {
      "type": "boolean",
      "default": false
    },
    "recording_notice_text": {
      "type": "string",
      "default": "Calls may be recorded for quality and training purposes."
    },
    "recording_consent_mode": {
      "type": "string",
      "enum": [
        "notice",
        "consent",
        "explicit_consent"
      ],
      "default": "notice"
    },
    "recording_retention_days": {
      "type": "number",
      "default": 90
    },
    "call_log_retention_days": {
      "type": "number",
      "default": 365
    },
    "contact_retention_days": {
      "type": "number",
      "default": 730
    },
    "prospect_retention_days": {
      "type": "number",
      "default": 365
    },
    "unsuccessful_prospect_retention_days": {
      "type": "number",
      "default": 180
    },
    "audit_retention_days": {
      "type": "number",
      "default": 1825
    },
    "suppression_retention_policy": {
      "type": "string",
      "enum": [
        "permanent",
        "fixed_term",
        "review_based"
      ],
      "default": "permanent"
    },
    "privacy_contact_name": {
      "type": "string"
    },
    "privacy_contact_email": {
      "type": "string"
    },
    "data_controller_name": {
      "type": "string"
    },
    "data_processor_name": {
      "type": "string"
    },
    "privacy_policy_url": {
      "type": "string"
    },
    "legitimate_interest_assessment_reference": {
      "type": "string"
    },
    "compliance_notice": {
      "type": "string",
      "default": "Cadence provides controls to support your compliance process. Your organisation remains responsible for determining its lawful basis and calling policies."
    },
    "calling_hours_config": {
      "type": "object",
      "description": "Per-country calling hours configuration."
    },
    "updated_by_user_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organisation_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organisation_id": "{{user.data.organisation_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}