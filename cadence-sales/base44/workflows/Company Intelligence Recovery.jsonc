{
  "name": "Company Intelligence Recovery",
  "description": "One consolidated nightly job that researches companies missing current CompanyIntelligence (one LLM request per company, reused across all its contacts) and backfills company firmographics. Replaces the two former hourly overnight workflows, which could not run without an app-user session. Bounded batch per run; remaining companies research on later runs.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 23 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "company_intelligence_recovery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "research_companies": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "buildBriefsBatch"
          },
          "then": "end",
          "x-base44": {
            "title": "Research companies",
            "description": "Builds reusable company intelligence once per company"
          }
        }
      }
    ]
  }
}