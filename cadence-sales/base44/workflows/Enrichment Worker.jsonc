{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "enrichment_worker",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_batch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processEnrichmentBatch"
          },
          "then": "end",
          "x-base44": {
            "title": "Process enrichment batch",
            "description": "Finds and processes pending enrichment items"
          }
        }
      }
    ]
  },
  "name": "Enrichment Worker",
  "description": "Background worker that processes pending enrichment sessions every 5 minutes \u2014 continues enrichment even when the user's browser is closed or they are using the Dialler."
}