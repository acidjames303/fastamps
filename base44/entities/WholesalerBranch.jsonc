{
  "name": "WholesalerBranch",
  "type": "object",
  "properties": {
    "wholesaler_name": {
      "type": "string",
      "description": "Approved canonical wholesaler company name"
    },
    "branch_name": {
      "type": "string",
      "description": "Approved canonical branch identifier or location"
    },
    "town": {
      "type": "string",
      "description": "Branch town or city for installer search"
    },
    "postcode": {
      "type": "string",
      "description": "Branch postcode for installer search"
    },
    "county": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "United Kingdom"
    },
    "programme_availability": {
      "type": "string",
      "enum": [
        "not_available",
        "planned",
        "active",
        "paused",
        "closed"
      ],
      "default": "not_available",
      "description": "Nationwide rollout status for this branch"
    },
    "approved_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Explicitly approved alternate full wholesaler/branch spellings; no fuzzy matching"
    }
  },
  "required": [
    "wholesaler_name",
    "branch_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
