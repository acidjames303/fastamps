{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "development",
        "distribution",
        "commercial",
        "lead",
        "referral"
      ],
      "default": "lead"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "distance_miles": {
      "type": "number"
    },
    "reward": {
      "type": "number",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "potential_value": {
      "type": "number",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "submitted",
        "converted",
        "closed"
      ],
      "default": "open",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "accepted_by": {
      "type": "string",
      "description": "Installer mobile",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "reward"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}